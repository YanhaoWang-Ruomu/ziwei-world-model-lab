{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ziwei-world-model-lab",
  "main": "server/cloudflare-worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/downloads/*", "/signin-with-chatgpt", "/signout", "/__test*", "/__preview*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ziwei-cloudflare",
    "database_id": "REPLACE_WITH_NEW_DATABASE_ID",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [],
  "vars": {
    "AUTH_MODE": "standalone",
    "FOUNDER_ACCOUNT_ID": ""
  },
  "observability": { "enabled": false }
}
